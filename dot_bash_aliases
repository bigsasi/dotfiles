# ~/.bash_aliases - Personal aliases & helper functions

# 1. Modern file listing (eza with git status, fallback to ls)
if command -v eza >/dev/null 2>&1; then
    alias ls='eza --group-directories-first'
    alias ll='eza -lh --git --group-directories-first'
    alias la='eza -lah --git --group-directories-first'
    alias lt='eza --tree --level=2 --group-directories-first'
    alias l='eza -F --group-directories-first'
else
    alias ll='ls -lh'
    alias la='ls -lAh'
    alias l='ls -CF'
fi

# 2. Syntax-highlighted file viewing (bat)
if command -v bat >/dev/null 2>&1; then
    alias catp='bat -p'
    alias bcat='bat'
fi

# 3. Quick Directory Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias -- -='cd -'

# 4. Git Shortcuts
alias g='git'
alias gs='git status -sb'
alias ga='git add'
alias gc='git commit'
alias gcm='git commit -m'
alias gco='git checkout'
alias gd='git diff'
alias gds='git diff --staged'
alias gl='git log --oneline --graph --decorate -n 20'
alias gp='git push'
alias gpl='git pull'

# 5. Chezmoi Dotfiles Shortcuts
alias cm='chezmoi'
alias cms='chezmoi status'
alias cmd='chezmoi diff'
alias cma='chezmoi apply'
alias cmcd='chezmoi cd'

# 6. Helper Functions
# Create a directory and cd into it immediately
mkcd() {
    mkdir -p "$1" && cd "$1" || return
}

# Universal archive extractor
extract() {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2)   tar xjf "$1"     ;;
            *.tar.gz)    tar xzf "$1"     ;;
            *.tar.xz)    tar xJf "$1"     ;;
            *.bz2)       bunzip2 "$1"     ;;
            *.rar)       unrar x "$1"     ;;
            *.gz)        gunzip "$1"      ;;
            *.tar)       tar xf "$1"      ;;
            *.tbz2)      tar xjf "$1"     ;;
            *.tgz)       tar xzf "$1"     ;;
            *.zip)       unzip "$1"       ;;
            *.Z)         uncompress "$1"  ;;
            *.7z)        7z x "$1"        ;;
            *)           echo "'$1' cannot be extracted via extract()" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}
