# ~/.inputrc: Readline configuration for fast, clean Bash navigation & completion

$include /etc/inputrc

# 1. Case-insensitive tab completion (and treat - and _ as equivalent)
set completion-ignore-case on
set completion-map-case on

# 2. Show completions immediately on single Tab (no bell or double-tab needed)
set show-all-if-ambiguous on
set show-all-if-unmodified on

# 3. Colorize completion entries by file type (like ls --color) and highlight common prefix
set colored-stats on
set colored-completion-prefix on
set visible-stats on
set mark-symlinked-directories on

# 4. Smart history prefix search with Up/Down arrows
# Type "git " and press Up to cycle only through previous "git ..." commands
"\e[A": history-search-backward
"\e[B": history-search-forward
"\eOA": history-search-backward
"\eOB": history-search-forward

# 5. Fast word navigation with Ctrl+Left / Ctrl+Right
"\e[1;5C": forward-word
"\e[1;5D": backward-word
"\e[5C": forward-word
"\e[5D": backward-word

# 6. Clean pasting without accidentally executing multiline snippets immediately
set enable-bracketed-paste on
set bell-style none
