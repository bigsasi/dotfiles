
filetype off                   " required!

set clipboard=unnamed

"Leader key
let mapleader = ','

" Vundle setup
set nocompatible               " be iMproved
set rtp+=~/.vim/bundle/Vundle.vim
call vundle#rc()

" Tab setup
set smartindent
set tabstop=2
set shiftwidth=2
set expandtab

autocmd BufWritePre,FileWritePre * execute "silent '[,']retab!"

" Session setup
let g:session_dir = '~/.vim/sessions'
exec 'nnoremap <Leader>ss :mks! ' . g:session_dir . '/'
exec 'nnoremap <Leader>sr :so ' . g:session_dir . '/'


" Autowrap files longer than 80 chars
set wrap
set textwidth=120

" Improve searching command
set incsearch hlsearch

" When a bracket is inserted, briefly jump to a matching one
set showmatch

" Show line, column number, and relative position within a file in the status line
set ruler

" Statusbar configuration
function! GitBranch()
    return system("git rev-parse --abbrev-ref HEAD 2>/dev/null | tr -d '\n'")
  endfunction

function! StatuslineGit()
  let l:branchname = GitBranch()
  return strlen(l:branchname) > 0?'  '.l:branchname.' ':''
endfunction

set statusline=
set statusline+=%#PmenuSel#
set statusline+=%{StatuslineGit()}
set statusline+=%#LineNr#
set statusline+=\ %f
set statusline+=%m
set statusline+=%=
set statusline+=%#CursorColumn#
set statusline+=\ %y
set statusline+=\ %{&fileencoding?&fileencoding:&encoding}
set statusline+=\[%{&fileformat}\]
set statusline+=\ %p%%
set statusline+=\ %l:%c
set statusline+=\ 


" Show statusbar all the time
set laststatus=2                      


" Enable syntax highlighting
syntax on

" Enable line numbers
set number

" Command line autocomplete menu
set wildchar=<Tab> wildmenu wildmode=full

" Easier buffer switching 
set wildcharm=<C-Z>
nnoremap <F10> :b <C-Z>

" let Vundle manage Vundle
Plugin 'VundleVim/Vundle.vim'

