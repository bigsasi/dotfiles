" Disable cursor movements (become better at Vim)
map <up> <nop>
map <down> <nop>
map <left> <nop>
map <right> <nop>
imap <up> <nop>
imap <left> <nop>
imap <right> <nop>

" Easy split navigation 
nnoremap <C-J> <C-W><C-J>
nnoremap <C-K> <C-W><C-K>
nnoremap <C-L> <C-W><C-L>
nnoremap <C-H> <C-W><C-H>

" More natural split
set splitbelow
set splitright

" Enable autocomplete brackets, parentheses, cruly brackets, ...
":inoremap ( ()<Esc>i
":inoremap [ []<Esc>i
":inoremap { {}<Esc>i
":inoremap < <><Esc>i
":inoremap " ""<Esc>i
":inoremap ' ''<Esc>i
":inoremap ` ``<Esc>i

" CtrlP setup
let g:ctrlp_map = '<c-p>'
let g:ctrlp_cmd = 'CtrlP'
let g:ctrlp_working_path_mode = 'ra'

set wildignore+=*/tmp/*,*.so,*.swp,*.zip,.git,.svn,.hg     " MacOSX/Linux
"set wildignore+=*\\tmp\\*,*.swp,*.zip,*.exe  " Windows

"let g:ctrlp_user_command = 'find %s -type f'        " MacOSX/Linux
"let g:ctrlp_user_command = 'dir %s /-n /b /s /a-d'  " Windows

"VimNotes setup
let g:notes_directories = ['~/Dropbox/vimnotes']
let g:notes_suffix = '.md'

" Erlang setup
filetype plugin indent on
let g:erlangCompleteFile="~/.vim/bundle/vim-erlang-omnicomplete/autoload/erlang_complete.erl"
set cot-=preview
let g:erlang_completion_preview_help = 0
"let g:erlangCheckFile="~/.vim/bundle/vimerl/compiler/erlang_check.erl"
"set foldenable
"let g:erlangFold = 1 " Don't fold block of code by default
let g:erlangHighlightBif = 1
let g:erlangHighLightOperators=1

"Go setup
au BufRead,BufNewFile *.go set filetype=go
au FileType go nmap <leader>r <Plug>(go-run)
au FileType go nmap <leader>b <Plug>(go-build)
au FileType go nmap <leader>t <Plug>(go-test)
au FileType go nmap <leader>c <Plug>(go-coverage)
au FileType go nmap <leader>ds <Plug>(go-def-split)
au FileType go nmap <leader>dv <Plug>(go-def-vertical)
au FileType go nmap <leader>dt <Plug>(go-def-tab)
au FileType go nmap <leader>gd <Plug>(go-doc)
au FileType go nmap <leader>gv <Plug>(go-doc-vertical)

"Python setup
au BufRead,BufNewFile *.py set filetype=python
au FileType python set tabstop=4 
au FileType python set softtabstop=4
au FileType python set shiftwidth=4
au FileType python set textwidth=80
au FileType python set expandtab
au FileType python set autoindent
au FileType python set fileformat=unix

"Scala setup
au BufRead,BufNewFile *.scala set filetype=scala

"Txt2Tags setup
au BufRead,BufNewFile *.ndoc set filetype=txt2tags

"JSON setup
au! BufRead,BufNewFile *.json set filetype=json 

"C++ setup
au BufNewFile,BufRead,BufEnter *.cpp,*.hpp set omnifunc=omni#cpp#complete#Main

"format XML
command Xml setfiletype xml | %!xmllint\ --format\ --recover\ -\ 2>/dev/null

"format JSON
command Json setfiletype json | %!python -m json.tool
