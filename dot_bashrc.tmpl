# ~/.bashrc: executed by bash(1) for interactive non-login shells.

# 1. Non-interactive shells return early
case $- in
    *i*) ;;
      *) return;;
esac

# 2. History Settings (large, deduplicated, checkpointed every 5m & on exit)
SHELL_SESSION_HISTORY=0
HISTFILE="$HOME/.bash_history"
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend
shopt -s cmdhist
HISTSIZE=100000
HISTFILESIZE=200000
HISTTIMEFORMAT="%F %T "
HISTIGNORE="ls:ll:la:l:cd:pwd:exit:clear:history"

__hist_last_sync=${__hist_last_sync:-$SECONDS}
__sync_history() {
    local status=$?
    if (( SECONDS - __hist_last_sync >= 300 )); then
        history -a
        __hist_last_sync=$SECONDS
    fi
    return "$status"
}

if [[ "$(declare -p PROMPT_COMMAND 2>/dev/null)" == "declare -a"* ]]; then
    if [[ "${PROMPT_COMMAND[*]}" != *__sync_history* ]]; then
        PROMPT_COMMAND=(__sync_history "${PROMPT_COMMAND[@]}")
    fi
elif [[ "${PROMPT_COMMAND:-}" != *__sync_history* ]]; then
    PROMPT_COMMAND="__sync_history${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
fi

trap 'history -a' EXIT
trap 'history -a; trap - HUP; kill -HUP $$' HUP

# 3. Shell Options (ergonomic directory navigation & globbing)
shopt -s checkwinsize
shopt -s globstar 2>/dev/null
shopt -s autocd 2>/dev/null
shopt -s cdspell 2>/dev/null
shopt -s dirspell 2>/dev/null
shopt -s nocaseglob 2>/dev/null

# 4. Default Editor & Colored Man Pages
export EDITOR="vim"
export VISUAL="vim"

if command -v bat >/dev/null 2>&1; then
    export BAT_THEME="Nord"
    export MANPAGER="sh -c 'col -bx | bat -l man -p'"
    export MANROFFOPT="-c"
else
    export LESS_TERMCAP_mb=$'\e[1;31m'      # begin bold
    export LESS_TERMCAP_md=$'\e[1;36m'      # begin blink
    export LESS_TERMCAP_me=$'\e[0m'         # reset bold/blink
    export LESS_TERMCAP_so=$'\e[01;44;33m'  # begin reverse video
    export LESS_TERMCAP_se=$'\e[0m'         # reset reverse video
    export LESS_TERMCAP_us=$'\e[1;32m'      # begin underline
    export LESS_TERMCAP_ue=$'\e[0m'         # reset underline
    export GROFF_NO_SGR=1                   # compatibility for groff
fi

# 5. PATH & Platform Environment
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

{{ if eq .chezmoi.os "darwin" -}}
# macOS (Darwin) specific environment
[ -d "/opt/homebrew/bin" ] && eval "$(/opt/homebrew/bin/brew shellenv)"
[ -d "/usr/local/bin" ] && export PATH="/usr/local/bin:$PATH"
[ -d "/opt/local/bin" ] && export PATH="/opt/local/bin:/opt/local/sbin:$PATH"

# iTerm2 integration if installed
if [ -e "${HOME}/.iterm2_shell_integration.bash" ]; then
    source "${HOME}/.iterm2_shell_integration.bash"
fi
{{- else -}}
# Linux specific environment
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
fi
{{- end }}

# 6. Programmable Bash Completion
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  elif [ -f /usr/local/etc/bash_completion ]; then
    . /usr/local/etc/bash_completion
  fi
fi

# 7. User Exports
if [ -f "$HOME/.exports" ]; then
    . "$HOME/.exports"
fi

# 8. User Aliases & Helper Functions
if [ -f "$HOME/.bash_aliases" ]; then
    . "$HOME/.bash_aliases"
fi

# 9. Modern CLI Integrations (fzf & zoxide)
if command -v fzf >/dev/null 2>&1; then
    # Nord color palette & clean layout for fzf
    export FZF_DEFAULT_OPTS="--height 45% --layout=reverse --border=rounded --info=inline \
        --color=fg:#e5e9f0,bg:#2e3440,hl:#81a1c1 \
        --color=fg+:#eceff4,bg+:#3b4252,hl+:#88c0d0 \
        --color=info:#eacb8a,prompt:#bf6069,pointer:#b48dac \
        --color=marker:#a3be8b,spinner:#b48dac,header:#a3be8b"

    if command -v fd >/dev/null 2>&1; then
        export FZF_DEFAULT_COMMAND="fd --type f --hidden --follow --exclude .git"
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
        export FZF_ALT_C_COMMAND="fd --type d --hidden --follow --exclude .git"
    fi

    if command -v bat >/dev/null 2>&1; then
        export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {} 2>/dev/null || ls -la {}'"
    fi
    if command -v eza >/dev/null 2>&1; then
        export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --color=always {} | head -200'"
    fi

    eval "$(fzf --bash)"
fi

if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash)"
fi

# 10. Starship Prompt (with single-line right-aligned host)
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"

    __strip_ansi_prompt() {
        local s="${1//[$'\001\002']/}" esc=$'\e\[[0-9;]*[a-zA-Z]'
        while [[ $s =~ $esc ]]; do
            s="${s/"${BASH_REMATCH[0]}"/}"
        done
        REPLY="$s"
    }

    __starship_rprompt() {
        local status=$?
        local -a args=(
            --terminal-width="${COLUMNS:-80}"
            --status="${STARSHIP_CMD_STATUS:-$status}"
            --pipestatus="${STARSHIP_PIPE_STATUS[*]:-0}"
            --jobs="${STARSHIP_NUM_JOBS:-0}"
            --shlvl="${SHLVL:-1}"
        )
        if [[ -n "${STARSHIP_DURATION:-}" ]]; then
            args+=(--cmd-duration="$STARSHIP_DURATION")
            STARSHIP_DURATION=""
        fi

        local rprompt
        rprompt="$(starship prompt --right "${args[@]}")"
        rprompt="${rprompt//[$'\001\002']/}"
        if [[ -n "$rprompt" ]]; then
            __strip_ansi_prompt "$rprompt"
            local rplain="$REPLY" prefix=""
            while [[ "$PS1" == $'\n'* ]]; do
                prefix+=$'\n'
                PS1="${PS1#$'\n'}"
            done
            __strip_ansi_prompt "$PS1"
            local lplain="$REPLY"
            local col=$(( ${COLUMNS:-80} - ${#rplain} + 1 ))
            if (( ${#rplain} > 0 && col > ${#lplain} + 4 )); then
                PS1="${prefix}"$'\001\e['"${col}G${rprompt}"$'\e[0m\r\002'"${PS1}"
            else
                PS1="${prefix}${PS1}"
            fi
        fi
        return "$status"
    }

    if [[ "$(declare -p PROMPT_COMMAND 2>/dev/null)" == "declare -a"* ]]; then
        if [[ "${PROMPT_COMMAND[*]}" != *__starship_rprompt* ]]; then
            PROMPT_COMMAND+=(__starship_rprompt)
        fi
    elif [[ "${PROMPT_COMMAND:-}" != *__starship_rprompt* ]]; then
        PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND$'\n'}__starship_rprompt"
    fi
fi
